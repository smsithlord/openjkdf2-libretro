# Core info file for the OpenJKDF2 libretro core. Frontends read this from
# their info directory (keyed by the core's dll basename). Without it,
# RetroArch >= 1.15 disables savestates entirely (a core with no info file
# gets savestate support level 0). savestate_features "basic" enables the
# save/load state slots while keeping rewind ("serialized") and
# run-ahead/netplay ("deterministic") off -- correct for this core: states
# are engine savegames restored asynchronously, not frame-exact memory
# snapshots (see DESIGN.md).
display_name = "Star Wars: Jedi Knight - Dark Forces II (OpenJKDF2)"
